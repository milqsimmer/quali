<?xml version="1.0" ?>
<robot name="two_link_arm">

  <!-- Base fixa -->
  <link name="base_link">
    <inertial>
      <mass value="0.0"/>
      <inertia ixx="0" iyy="0" izz="0"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
      <origin xyz="0 0 0.05"/>
    </visual>
  </link>

  <!-- Primeiro segmento (ombro) -->
  <link name="link1">
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01"/>
    </inertial>
    <visual>
      <origin xyz="0.25 0 0" rpy="0 1.57 0"/>
      <geometry>
        <cylinder length="0.5" radius="0.05"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.2 1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.25 0 0"/>
      <geometry>
        <cylinder length="0.5" radius="0.05"/>
      </geometry>
    </collision>
  </link>

  <!-- Segundo segmento (cotovelo) -->
  <link name="link2">
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01"/>
    </inertial>
    <visual>
      <origin xyz="0.25 0 0" rpy="0 1.57 0"/>
      <geometry>
        <cylinder length="0.5" radius="0.04"/>
      </geometry>
      <material name="green">
        <color rgba="0.2 1 0.2 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.25 0 0"/>
      <geometry>
        <cylinder length="0.5" radius="0.04"/>
      </geometry>
    </collision>
  </link>

  <!-- Junta 1: ombro -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="20" velocity="5"/>
  </joint>

  <!-- Junta 2: cotovelo -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0.5 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="20" velocity="5"/>
  </joint>

</robot>
